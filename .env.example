# ==============================================================================
# InsightLoop Enterprise Configuration (.env.example)
# Exactly mirrors render-blueprint.yaml environment variables
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service (Node.js API)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=10000
HOST=0.0.0.0
TRUST_PROXY=1
APP_TIME_ZONE=Asia/Kolkata

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/InsightLoop
MONGODB_DB_NAME=InsightLoop
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=production-secret-must-be-at-least-32-chars-long
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=https://insightloop.onrender.com,http://localhost:5173
GOOGLE_CLIENT_ID=572736622320-3mtp1g63p07t1karnjo4df2nt3s6kmko.apps.googleusercontent.com
REHASH_PASSWORDS_ON_LOGIN=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# Storage Driver (GridFS with optional S3 fallback)
STORAGE_DRIVER=gridfs
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
S3_BUCKET_NAME=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SERVE_STATIC=false
GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo

# Communications
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
OPENWA_API_KEY=
OPENWA_BASE_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_BILL_TEMPLATE_NAME=bill_share
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=noreply@insightloop.io
ADMIN_EMAIL=admin@insightloop.io

# ------------------------------------------------------------------------------
# Frontend Service (React Web CDN)
# ------------------------------------------------------------------------------
VITE_API_URL=https://insightloop-api.onrender.com
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=wss://insightloop-api.onrender.com
VITE_GOOGLE_CLIENT_ID=572736622320-3mtp1g63p07t1karnjo4df2nt3s6kmko.apps.googleusercontent.com
