# Production backend example for this project:
# https://insightloop.onrender.com/api/v1
# Use your local backend during development instead.
VITE_API_BASE_URL=https://insightloop.onrender.com/api/v1
# Production websocket endpoint for this project:
# wss://insightloop.onrender.com
VITE_WS_BASE_URL=wss://insightloop.onrender.com
# Google OAuth Client ID (the same value as GOOGLE_CLIENT_ID on the
# backend) -- used client-side to render the "Sign in with Google" button
# via Google Identity Services. This is a public value by design (it's
# meant to be visible in browser requests), unlike the backend's client
# secret which must never be exposed here.
VITE_GOOGLE_CLIENT_ID=572736622320-3mtp1g63p07t1karnjo4df2nt3s6kmko.apps.googleusercontent.com
