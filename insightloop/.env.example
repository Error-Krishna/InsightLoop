# Core Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver,insightloop.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://insightloop.onrender.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB
# Local MongoDB example:
# MONGODB_URI=mongodb://localhost:27017/InsightLoop
#
# MongoDB Atlas development example using a standard connection string
# instead of mongodb+srv to avoid SRV/DNS startup delays:
# MONGODB_URI=mongodb://<USERNAME>:<URL_ENCODED_PASSWORD>@host1:27017,host2:27017,host3:27017/InsightLoop?tls=true&authSource=admin&replicaSet=<replica-set>&retryWrites=true&w=majority&appName=InsightLoop&serverSelectionTimeoutMS=5000&connectTimeoutMS=5000&socketTimeoutMS=5000
MONGODB_URI=mongodb://localhost:27017/InsightLoop
MONGODB_DB_NAME=InsightLoop
MONGODB_CONNECT_ON_INIT=false
# Used automatically when running `manage.py test` (defaults to
# "<MONGODB_DB_NAME>_test" if not set) -- keeps test runs from ever
# touching your real database.
# MONGODB_TEST_DB_NAME=InsightLoop_test

# Redis / Channels
REDIS_URL=

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
ADMIN_EMAIL=admin@example.com

# OAuth / Social Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback/

# WhatsApp Business Cloud API (Meta)
# Leave these as-is until you have real Meta credentials -- the app detects
# the placeholder values and disables WhatsApp sharing with a clear error
# instead of trying to call Meta's API with invalid credentials.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_ACCESS_TOKEN
WHATSAPP_BUSINESS_ACCOUNT_ID=REPLACE_WITH_BUSINESS_ACCOUNT_ID
WHATSAPP_BILL_TEMPLATE_NAME=bill_share
WHATSAPP_BILL_TEMPLATE_LANGUAGE=en_US

# TEMPORARY -- OpenWA bridge (open-wa/wa-automate self-hosted server) used
# to test WhatsApp sharing until real Meta credentials above are filled in.
# Once Meta credentials are set, WHATSAPP_PROVIDER can be removed entirely
# (see the removal checklist in insightloop/settings.py, search
# WHATSAPP_PROVIDER) along with these OPENWA_* values and
# bills/whatsapp_openwa.py.
WHATSAPP_PROVIDER=openwa
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback/

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback/

# Optional S3 / media storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
