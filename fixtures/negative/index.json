[
  {
    "id": "01_missing_company_id_bill",
    "description": "Bill creation without authentication credentials",
    "endpoint": "/api/v1/bills/pakka",
    "method": "POST",
    "payload": {
      "buyer": { "name": "Buyer Test" },
      "products": [{ "name": "Item", "quantity": 1, "rate": 100 }]
    },
    "expectedStatus": 401,
    "expectedErrorSubstring": "Authentication credentials were not provided",
    "useAuth": false
  },
  {
    "id": "02_duplicate_bill_conversion",
    "description": "Attempting to convert an already pakka bill",
    "endpoint": "/api/v1/bills/:pakkaBillId/convert",
    "method": "POST",
    "payload": { "gst_number": "29ABCDE1234F1Z5" },
    "expectedStatus": 400,
    "expectedErrorSubstring": "Bill is already a pakka (formal) bill.",
    "useAuth": true
  },
  {
    "id": "03_shipment_without_ready_to_deliver",
    "description": "Confirming shipment on bill without ready-to-deliver batches",
    "endpoint": "/api/v1/bills/:kachaBillId/confirm-shipment",
    "method": "POST",
    "payload": {},
    "expectedStatus": 400,
    "expectedErrorSubstring": "No ready-to-deliver batches recorded for this order yet.",
    "useAuth": true
  },
  {
    "id": "04_empty_products_list_bill",
