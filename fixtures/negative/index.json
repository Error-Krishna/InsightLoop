    "payload": {
      "buyer": { "name": "Buyer Test" },
      "products": []
    },
    "expectedStatus": 400,
    "expectedErrorSubstring": "At least one product is required",
    "useAuth": true
  },
  {
    "id": "05_negative_transportation_cost",
